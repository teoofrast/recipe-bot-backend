# Copy to .env and fill in: cp .env.example .env

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend API key: every request must send it in the X-API-Key header
API_KEY=change-me

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free chat models, comma-separated, in fallback order (defaults are in bootstrap/settings.py).
# Extraction needs structured output, chat needs tool calling: check on openrouter.ai/models.
# LLM_EXTRACT_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-super-vl:free
# LLM_CHAT_MODELS=nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free
# Hard limit per model call in seconds, then the next model is tried
# LLM_EXTRACT_TIMEOUT_SECONDS=120
# LLM_CHAT_TIMEOUT_SECONDS=40

# Optional LangSmith tracing of every LLM call (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=recipe-bot
# Speech-to-text models, comma-separated, in fallback order. Paid: the OpenRouter balance must
# have credits. gpt-4o-mini-transcribe ~ $0.0018/min, whisper-large-v3-turbo ~ $0.0002/min.
# STT_MODELS=openai/gpt-4o-mini-transcribe,openai/whisper-large-v3-turbo

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Cookies for yt-dlp (Netscape format), usually needed for Instagram.
# Export them from a logged-in browser into data/cookies/ (data/ is mounted into the container):
# Relative path works both locally and in the container (WORKDIR /app):
# YTDLP_COOKIES_FILE=data/cookies/instagram.txt

# Imports running at once; the rest wait in the "queued" status
# IMPORT_CONCURRENCY=2

# Subtitle languages to try after the video's own language, comma-separated
# SUBTITLE_LANGUAGES=ru,en

# Search index (Chroma). Defaults fit local runs (uv run): the compose service on host port 8001.
# Inside docker-compose the services get chroma:8000 from docker-compose.yml.
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# Embedding model on OpenRouter for search
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Lowest similarity (0..1) a search hit may have; tuned for the E5 model above
# SEARCH_MIN_SCORE=0.78

# Path to the frontend repo for docker-compose (default: ../recipe-bot-frontend)
# FRONTEND_PATH=../recipe-bot-frontend
