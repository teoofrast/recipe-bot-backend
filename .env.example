# Copy to .env and fill in: cp .env.example .env

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend API key: every request must send it in the X-API-Key header
API_KEY=change-me

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated, in fallback order. Extraction needs structured output, chat needs tool calling.
LLM_EXTRACT_MODELS=
LLM_CHAT_MODELS=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Vector store (service name inside docker-compose)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Path to the frontend repo for docker-compose (default: ../recipe-bot-frontend)
# FRONTEND_PATH=../recipe-bot-frontend
